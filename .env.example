# Salin file ini jadi ".env" lalu isi token bot kamu
# Dapatkan token dari @BotFather di Telegram

BOT_TOKEN=isi_token_bot_disini

# Opsional: batas ukuran file (MB) yang boleh dikirim bot
# Bot Telegram biasa (bukan self-hosted API server) maksimal 50MB per file
MAX_FILE_SIZE_MB=48

# Opsional: ID Telegram kamu (dari @userinfobot), boleh dikosongin
OWNER_ID=

GALLERY_DL_COOKIES_FILE=