# Token bot dari @BotFather (WAJIB)
BOT_TOKEN=

# ID Telegram kamu dari @userinfobot (sangat disarankan)
# Kalau kosong, siapa aja yang tau username bot bisa pakai
OWNER_ID=

# Batas ukuran file yang boleh dikirim (MB). Limit Bot API biasa ±50MB
MAX_FILE_SIZE_MB=48

# Path ke file cookies Netscape format
# Dipakai gallery-dl (fallback foto Instagram/X)
GALLERY_DL_COOKIES_FILE=

# Path ke file cookies untuk yt-dlp (age-restricted / private video)
# Kalau kosong, otomatis pakai GALLERY_DL_COOKIES_FILE
YTDLP_COOKIES_FILE=

# URL banner menu utama (fallback kalau src/image/banner.jpg tidak ada)
BANNER_URL=

# Maks video yang didownload sekali dari playlist YouTube
PLAYLIST_LIMIT=5

# Kompres otomatis video yang kelebihan MAX_FILE_SIZE_MB (true/false)
AUTO_COMPRESS=true

# Hapus file sementara di downloads/ yang lebih tua dari N jam (default 1)
DOWNLOAD_CLEANUP_HOURS=1

# Rate limit: max download per window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

COIN_SYSTEM=false
COIN_START=30
COIN_COST_DOWNLOAD=1
COIN_REFERRAL_BONUS=10